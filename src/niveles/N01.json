        { "orden": 1, "x": 1, "y": 0 },
        { "orden": 2, "x": 0, "y": 1 }
      ],
      "iniciales": {},
      "objetivo": { "1": "B", "2": "A" },
      "posicionObjetivo": { "x": 0, "y": 0 },
      "plantilla": [
        "pila.push({{h1}})",
        "pila.push({{h2}})",
        "armar(pila.pop())",
