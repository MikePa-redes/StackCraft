      ["vacia", "vacia", "vacia"],
      ["vacia", "fuera", "fuera"]
    ],
    "piezasReferencia": []
  },
  "bandeja": ["C"],
  "piezas": [
    {
      "id": "PIEZA_01",
      "nucleo": [[0, 0]],
      "anclajes": [
        { "orden": 1, "x": 1, "y": 0 },
        { "orden": 2, "x": 0, "y": 1 },
        { "orden": 3, "x": 1, "y": 1 }
      ],
      "iniciales": { "1": "A", "2": "B" },
      "objetivo": { "1": "A", "2": "C", "3": "B" },
