      "plantilla": [
        "pila.push(desarmar(PIEZA_01))",
        "pila.push({{h1}})",
        "armar(pila.pop())",
        "armar(pila.pop())"
      ],
      "huecos": {
        "h1": { "tipo": "lista", "opciones": ["\"A\"", "\"B\"", "\"C\""] }
